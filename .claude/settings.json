{
  "$comment": "Arnés SDD. Los hooks los ejecuta Claude Code, no el agente, así que no se pueden saltar. Lo específico del stack vive en harness.config.json; aquí solo hay permisos y hooks. El allowlist cubre pnpm, npm y yarn a propósito, para que cambiar de gestor de paquetes no obligue a editar este archivo.",
  "permissions": {
    "allow": [
      "Bash(./init.sh)",
      "Bash(./scripts/check-dependency-rule.sh*)",
      "Bash(node scripts/*)",
      "Bash(node -e *)",
      "Bash(node -p *)",
      "Bash(node --input-type=module -e *)",
      "Bash(pnpm install*)",
      "Bash(pnpm test*)",
      "Bash(pnpm exec*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm build*)",
      "Bash(npm install*)",
      "Bash(npm test*)",
      "Bash(npm run*)",
      "Bash(npx*)",
      "Bash(yarn install*)",
      "Bash(yarn test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(pnpm add*)",
      "Bash(pnpm remove*)",
      "Bash(npm uninstall*)",
      "Bash(yarn add*)"
    ],
    "deny": [
      "Read(./src/.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  },
  "skillOverrides": {
    "caveman": "user-invocable-only"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-test.sh\"",
            "timeout": 120,
            "statusMessage": "Corriendo la suite tras editar código fuente…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.sh\"",
            "timeout": 300,
            "statusMessage": "Verificando el arnés antes de cerrar…"
          }
        ]
      }
    ]
  }
}
